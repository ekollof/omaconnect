#!/usr/bin/env python3
"""omaconnect-exec — bounded framing layer between kcd (phone-influenced
data) and QML. Quickshell accumulates process output and watch-stream lines
with no byte ceiling, so a compromised/malformed peer or backend could
exhaust the shared shell process before Model.js ever parses a byte.

    omaconnect-exec run <max-total-bytes> -- cmd...    one-shot: stdout and
        stderr each capped; overflow kills the producer group, prints
        nothing, exits 3.
    omaconnect-exec watch <max-line-bytes> -- cmd...   stream: records longer
        than the cap are dropped (stderr note); >100 consecutive drops kills
        the producer group and exits 3.
    omaconnect-exec exec -- cmd...    resolve cmd through the trusted
        directory allowlist and replace this process with it (no framing,
        no return). For fire-and-forget invocations that still need trusted
        resolution and a controlled environment.

Exit codes: the producer's code on success; 3 on any limit breach; 124 on
producer timeout (run mode, 120s); 2 on misuse.

Design (all data paths are anonymous):
- Transport is anonymous ``os.pipe2`` pairs only. There are no pathnames to
  guess, swap, or re-resolve — no tmpdirs, no FIFOs, no stat/cat cycles. All
  reads/writes go through already-open descriptors.
- The producer runs in its own process group (``start_new_session``) so
  exit/overflow/timeout paths can killpg/reap the whole descendant tree;
  nothing forked downstream can retain a pipe writer or survive the wrapper.
- Bytes are counted and forwarded verbatim (no decoding), so multibyte
  input is measured exactly and split points never alter data.
"""
import os
import selectors
import signal
import stat
import subprocess
import sys
import time
RUN_TIMEOUT_SECS = 120
WATCH_MAX_CONSECUTIVE_DROPS = 100
WATCH_LIVENESS_SECS = 5.0
CHUNK = 65536

# Executables may only come from these directories, must be root-owned
# regular files, and must not be group/world-writable. Ambient PATH is never
# consulted: the same UID could otherwise shadow a name, and resolving now
# but executing later would leave a replacement race. /bin is kept for
# completeness (on Arch it is a symlink to /usr/bin).
TRUSTED_DIRS = ("/usr/bin", "/bin")

# Environment passed to producers: an explicit allowlist plus deterministic
# locale and PATH. Everything else (LD_PRELOAD, BASH_ENV, TMPDIR, …) is
# dropped. The kept entries are the ones kcd/standard tools need to locate
# the daemon socket, session bus, and config; none of them are influenced
# by phone-controlled data.
SAFE_ENV_KEEP = (
    "HOME",
    "USER",
    "LOGNAME",
    "XDG_RUNTIME_DIR",
    "XDG_CONFIG_HOME",
    "XDG_SESSION_TYPE",
    "XDG_CURRENT_DESKTOP",
    "WAYLAND_DISPLAY",
    "DISPLAY",
    "DBUS_SESSION_BUS_ADDRESS",
)


def build_env():
    env = {"LC_ALL": "C", "PATH": "/usr/bin:/bin"}
    for key in SAFE_ENV_KEEP:
        value = os.environ.get(key)
        if value:
            env[key] = value
    return env


def resolve_prog(name):
    """Resolve a bare program name to a verified absolute path.

    Rejects slashes (callers pass bare names only), non-regular files,
    group/world-writable files, and non-root owners. Raises
    FileNotFoundError when nothing trustworthy matches.
    """
    if not name or "/" in name:
        raise FileNotFoundError(name)
    for directory in TRUSTED_DIRS:
        path = os.path.join(directory, name)
        try:
            st = os.stat(path)
        except OSError:
            continue
        if not stat.S_ISREG(st.st_mode):
            continue
        if st.st_mode & 0o022:
            continue
        if st.st_uid != 0:
            continue
        return path
    raise FileNotFoundError(name)


class _Terminate(BaseException):
    """Raised by the SIGTERM/SIGINT handler so blocking reads/selects
    unwind through the normal cleanup path (group kill + reap)."""


def _handle_term(signum, _frame):
    raise _Terminate()


def install_handlers():
    signal.signal(signal.SIGTERM, _handle_term)
    signal.signal(signal.SIGINT, _handle_term)


def usage():
    sys.stderr.write(
        "usage: omaconnect-exec {run <max-bytes> | "
        "watch <max-line-bytes>} -- cmd...\n"
    )
    return 2


def spawn(cmd):
    """Start cmd with stdout/stderr on fresh anonymous pipes.

    Returns (Popen, out_fd, err_fd). The executable is resolved through
    resolve_prog() (no ambient PATH, no lookup-to-exec gap: verification
    and exec happen back-to-back on a root-owned non-writable file), the
    environment is the controlled build_env(), and the producer leads its
    own process group for whole-tree kill/reap.
    """
    resolved = resolve_prog(cmd[0])
    full_cmd = [resolved] + list(cmd[1:])
    out_r, out_w = os.pipe2(os.O_CLOEXEC | os.O_NONBLOCK)
    err_r, err_w = os.pipe2(os.O_CLOEXEC | os.O_NONBLOCK)
    try:
        proc = subprocess.Popen(
            full_cmd,
            stdin=subprocess.DEVNULL,
            stdout=out_w,
            stderr=err_w,
            start_new_session=True,
            close_fds=True,
            env=build_env(),
        )
    finally:
        os.close(out_w)
        os.close(err_w)
    return proc, out_r, err_r


def exec_mode(cmd):
    """Resolve and replace this process with cmd (no framing, no return).

    For fire-and-forget invocations from QML so they get the same trusted
    resolution and controlled environment without a supervisory layer that
    would only add lifetime confusion. Never returns on success.
    """
    resolved = resolve_prog(cmd[0])
    os.execve(resolved, [resolved] + list(cmd[1:]), build_env())


def kill_group(proc):
    try:
        os.killpg(proc.pid, 9)
    except (ProcessLookupError, PermissionError, OSError):
        pass


def check_liveness(proc):
    """If the leader is gone, kill/reap its whole group and report True.

    Called on every loop pass (including selector timeouts) so a descendant
    holding pipes open can never wedge us past the leader's death: once the
    group is gone the remaining buffered bytes drain to EOF on their own.
    Idempotent.
    """
    if proc.poll() is None:
        return False
    kill_group(proc)
    reap(proc)
    return True


def reap(proc):
    """Wait for the producer; -1 if it is already gone. Catches BaseException
    (not just Exception) so a second signal landing inside teardown still
    unwinds instead of tracebacking."""
    try:
        return proc.wait()
    except BaseException:
        return -1


def norm_code(rc):
    """Match shell wait(1) semantics: signal deaths become 128+signo so
    QML (which only ran producers via bash before) sees identical codes."""
    if isinstance(rc, int) and rc < 0:
        return 128 + abs(rc)
    if isinstance(rc, int):
        return rc
    return 1


def run_mode(cap, cmd):
    proc, out_r, err_r = spawn(cmd)
    out_parts = []
    err_parts = []
    out_len = 0
    err_len = 0
    overflow = False
    sel = selectors.DefaultSelector()
    sel.register(out_r, selectors.EVENT_READ, "out")
    sel.register(err_r, selectors.EVENT_READ, "err")
    live = {"out", "err"}
    deadline = time.monotonic() + RUN_TIMEOUT_SECS
    timed_out = False
    result = 1
    try:
        while live:
            # Liveness: if the leader is gone, its group was just reaped
            # wholesale, so any holder keeping these pipes open is dead and
            # EOF follows on its own. Never break here: breaking would
            # discard the trailing output of clean exits.
            check_liveness(proc)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                break
            for key, _mask in sel.select(timeout=remaining):
                name = key.data
                try:
                    data = os.read(key.fd, CHUNK)
                except (BlockingIOError, InterruptedError):
                    continue
                except OSError:
                    data = b""
                if not data:
                    sel.unregister(key.fd)
                    os.close(key.fd)
                    live.discard(name)
                    continue
                if name == "out":
                    if out_len + len(data) > cap + 1:
                        overflow = True
                    else:
                        out_parts.append(data)
                        out_len += len(data)
                else:
                    if err_len + len(data) > cap + 1:
                        overflow = True
                    else:
                        err_parts.append(data)
                        err_len += len(data)
                if overflow:
                    break
            if overflow:
                break
        if timed_out:
            sys.stderr.write("omaconnect-exec: producer timed out\n")
            result = 124
        elif overflow:
            sys.stderr.write(
                "omaconnect-exec: one-shot output exceeded %d bytes, "
                "dropped\n" % cap
            )
            result = 3
        else:
            try:
                # Pipes are at EOF: the producer closed its ends and should
                # exit imminently. Short grace only — fail closed.
                result = norm_code(proc.wait(timeout=5))
            except subprocess.TimeoutExpired:
                sys.stderr.write("omaconnect-exec: producer lingered\n")
                result = 124
            if out_len > cap or err_len > cap:
                # Raced past the cap between the last check and EOF.
                sys.stderr.write(
                    "omaconnect-exec: one-shot output exceeded %d "
                    "bytes, dropped\n" % cap
                )
                result = 3
            else:
                # Emit on ANY exit code: QML reads stderr text to
                # report failures (only overflow/timeout suppress).
                if out_parts:
                    sys.stdout.buffer.write(b"".join(out_parts))
                    sys.stdout.buffer.flush()
                if err_parts:
                    sys.stderr.buffer.write(b"".join(err_parts))
                    sys.stderr.flush()
    except _Terminate:
        result = 143
    except BrokenPipeError:
        # Downstream (QML) went away first: teardown, quietly.
        result = 0
    finally:
        # Idempotent: killing an already-dead group is a no-op, and reap
        # always runs, so no descendant survives us and no child zombies.
        kill_group(proc)
        reap(proc)
    return result


def watch_mode(cap, cmd):
    proc, out_r, err_r = spawn(cmd)
    # Both streams stay open and multiplexed: producer stderr is drained and
    # dropped (never forwarded) so a chatty/flooding stderr can neither
    # SIGPIPE the producer nor wedge the loop. Nonblocking + selector keeps
    # idle streams at zero CPU without ever blocking unboundedly.
    sel = selectors.DefaultSelector()
    sel.register(out_r, selectors.EVENT_READ, "out")
    sel.register(err_r, selectors.EVENT_READ, "err")
    live = {"out", "err"}
    buf = bytearray()
    drops = 0
    # True once the in-progress record has exceeded the cap: its content is
    # doomed, but the boundary must still be located to resync framing.
    tainted = False
    result = 0

    def note(msg):
        try:
            sys.stderr.write("omaconnect-exec: %s\n" % msg)
            sys.stderr.flush()
        except OSError:
            pass

    def emit_record(rec):
        sys.stdout.buffer.write(bytes(rec) + b"\n")
        sys.stdout.buffer.flush()

    def drop_overlong():
        """Count one overlong record; True when the producer must die."""
        nonlocal drops
        drops += 1
        note("dropped overlong record (>%d bytes)" % cap)
        return drops > WATCH_MAX_CONSECUTIVE_DROPS

    try:
        # Bounded selector timeout (not indefinite): every pass — data or
        # timeout — runs the liveness probe below, so a dead leader with a
        # lingering pipe holder can never wedge the loop. No idle deadline:
        # an idle-but-connected watch stream is healthy by definition.
        while live:
            check_liveness(proc)
            for key, _mask in sel.select(timeout=WATCH_LIVENESS_SECS):
                name = key.data
                try:
                    data = os.read(key.fd, CHUNK)
                except (BlockingIOError, InterruptedError):
                    continue
                except OSError:
                    data = b""
                if not data:
                    try:
                        sel.unregister(key.fd)
                    except (ValueError, KeyError, OSError):
                        # Already unregistered/closed by an earlier pass.
                        pass
                    try:
                        os.close(key.fd)
                    except OSError:
                        pass
                    live.discard(name)
                    continue
                if name == "err":
                    continue  # drained and dropped, see above
                buf += data
                # Never hold more than one cap past the boundary search:
                # trim boundary-free excess as it arrives (doomed anyway).
                while True:
                    nl = buf.find(b"\n")
                    if nl < 0:
                        if len(buf) > cap:
                            if not tainted:
                                tainted = True
                                if drop_overlong():
                                    note("too many overlong records, "
                                         "stopping")
                                    result = 3
                                    raise _Terminate()
                            if cap > 0:
                                del buf[:-cap]
                            else:
                                del buf[:]
                        break
                    rec = bytes(buf[:nl])
                    del buf[: nl + 1]
                    if tainted:
                        # Already counted when the cap was crossed; a
                        # boundary-free buf can never complete untainted
                        # over the cap (trimmed above), so no second count.
                        tainted = False
                        continue
                    emit_record(rec)
                    drops = 0
        # Flush an unterminated tail as a final record.
        if buf:
            if tainted or len(buf) > cap:
                note("dropped overlong record (>%d bytes)" % cap)
            else:
                emit_record(bytes(buf))
    except _Terminate:
        # Signal, drop-limit stop, or our own raise above: result already set
        # where applicable; default is termination.
        if result == 0:
            result = 143
    except BrokenPipeError:
        # Downstream (QML) went away first: teardown, quietly.
        result = 0
    finally:
        # Idempotent whole-tree cleanup on every path — normal EOF, overflow
        # stop, signals, downstream loss, exceptions: the private producer
        # group is killed when live and the direct child always reaped.
        kill_group(proc)
        reap(proc)
    return result


def main(argv):
    if len(argv) < 3:
        return usage()
    if argv[0] == "exec":
        if len(argv) < 4 or argv[1] != "--":
            return usage()
        cmd = argv[2:]
        if not cmd:
            return usage()
        install_handlers()
        try:
            exec_mode(cmd)
        except (FileNotFoundError, OSError) as exc:
            sys.stderr.write("omaconnect-exec: cannot exec %s: %s\n" % (cmd[0], exc))
            return 127
        return 127  # unreachable; exec replaces the process on success
    if len(argv) < 4:
        return usage()
    mode, cap_s = argv[0], argv[1]
    if mode not in ("run", "watch") or argv[2] != "--" or len(argv) < 4:
        return usage()
    try:
        cap = int(cap_s)
    except ValueError:
        return usage()
    if cap <= 0:
        return usage()
    cmd = argv[3:]
    if not cmd:
        return usage()
    install_handlers()
    try:
        if mode == "run":
            return run_mode(cap, cmd)
        return watch_mode(cap, cmd)
    except FileNotFoundError as exc:
        sys.stderr.write("omaconnect-exec: command not found: %s\n" % exc)
        return 127


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
